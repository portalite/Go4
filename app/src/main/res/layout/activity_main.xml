<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/go4_background">

    <!-- Üst başlık -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/go4_primary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Go4"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="BROWSER"
            android:textColor="@color/go4_secondary"
            android:textSize="11sp"/>

    </LinearLayout>

    <!-- Adres çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="@string/search_hint"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:background="#FFFFFF"/>

        <Button
            android:id="@+id/goButton"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="Git"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/go4_secondary"/>

    </LinearLayout>

    <!-- Yükleme çubuğu -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone"
        android:indeterminate="true"
        android:progressTint="@color/go4_secondary"/>

    <!-- Web sayfası -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/browserView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </FrameLayout>

    <!-- Alt araç çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="‹"
            android:textSize="24sp"/>

        <Button
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="›"
            android:textSize="24sp"/>

        <Button
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂"
            android:textSize="24sp"/>

        <Button
            android:id="@+id/newTabButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+"
            android:textSize="24sp"/>

        <Button
            android:id="@+id/menuButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⋮"
            android:textSize="24sp"/>

    </LinearLayout>

</LinearLayout>